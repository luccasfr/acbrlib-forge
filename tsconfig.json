{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["bun"]
  },
  "include": ["*.ts", "src/**/*.ts", "src/**/*.tsx", "patches/*.ts", "tests/*.ts"]
}
